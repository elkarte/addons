---
---
{
    {% for category in site.categories %}
    {{ category[0] | jsonify }} : [
        {% for posts in category %}
            {% for post in posts %}
                {% if post.title %}
        {
            "pkid"        : {% if post.pkid %}{{ post.pkid | jsonify }}{% else %}""{% endif %},
            "title"       : {{ post.title | strip_html | jsonify }},
            "category"    : {{ post.category | jsonify }},
            "short"       : {{ post.short | strip_html | jsonify }},
            "author"      : {{ post.author | strip_html | jsonify }},
            "version"     : {{ post.version | append: '' | jsonify }},
            "date"        : {{ post.date | strip_html | jsonify }},
            "allhooks"    : {{ post.allhooks | append: '' | jsonify }},
            "elkversion"  : {{ post.elkversion | append: '' | jsonify }},
            "license"     : {% if post.license %}{{ post.license | jsonify }}{% else %}""{% endif %},
            "server"      : [
                {
                    "url"         : {{ site.baseurl | append: post.url | jsonify }},
                    "download"    : {{ post.download | jsonify }},
                    "bugs"        : {% if post.bugs %}{{ post.bugs | jsonify }}{% else %}""{% endif %},
                    "support"     : {% if post.support %}{{ post.support | jsonify }}{% else %}""{% endif %}
                }
            ]
        } {% unless forloop.last %},{% endunless %}
                {% endif %}
            {% endfor %}
        {% endfor %}
    ] {% unless forloop.last %},{% endunless %}
    {% endfor %}
}
